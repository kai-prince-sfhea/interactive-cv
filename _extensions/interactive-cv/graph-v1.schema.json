{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quarto:interactive-cv:graph:v1",
  "title": "Interactive CV single-file graph v1",
  "description": "Data-only CV graph v1; optional public.temporal/public.service survive native import. Runtime checks source identity, calendar uncertainty, provider consent declarations, closure and exact source-bound sidecars. No truth, legal, translation or accessibility assurance.",
  "type": "object",
  "required": [
    "version",
    "graph",
    "as-of",
    "nodes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "graph": {
      "allOf": [
        {
          "$ref": "#/$defs/graphOptions"
        },
        {
          "type": "object",
          "required": [
            "id",
            "label"
          ]
        }
      ]
    },
    "as-of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nodes": {
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/recordWithServices"
      },
      "type": "array"
    },
    "edges": {
      "maxItems": 2000,
      "items": {
        "properties": {
          "to": {
            "$ref": "#/$defs/identifier"
          },
          "predicate": {
            "$ref": "#/$defs/text"
          },
          "from": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required": [
          "from",
          "predicate",
          "to"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "graphOptions": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
            },
            "label": {
              "allOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "maxLength": 256
                }
              ]
            },
            "navigation": {
              "type": "boolean"
            },
            "search": {
              "type": "boolean"
            },
            "placement": {
              "enum": [
                "append",
                "placeholder"
              ],
              "default": "append"
            },
            "language": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*(?![\\s\\S])",
              "description": "Catalogue label language in the supported KG BCP47 subset; defaults to the document language. This does not translate records."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "placement"
                ],
                "properties": {
                  "placement": {
                    "const": "placeholder"
                  }
                }
              },
              "then": {
                "properties": {
                  "navigation": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      ],
      "description": "Default separate graph cv, navigation/search true and placement append. placeholder requires one empty cv-graph plus one cv-index and active navigation. KG must be activated for graph publication."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(?=[^\\u0000-\\u001f\\u007f]*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "identifier": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+(?![\\s\\S])"
        }
      ]
    },
    "anchor": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "catalogueFile": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "pattern": "^(?!/)(?!.*//)[A-Za-z0-9_./-]+\\.json(?![\\s\\S])"
        }
      ],
      "description": "Explicit relative local JSON catalogue path, exclusive with inline as-of and records. Dot/parent components can follow the containing input/configuration directory; runtime normalization must keep the effective path within its document/project root. This schema cannot establish confinement, symlink safety or file/content validity."
    },
    "destination": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "pattern": "^(?!/)(?!.*//)(?!\\.{1,2}/)(?!.*?/\\.{1,2}/)[A-Za-z0-9_./-]+\\.html(?:#[A-Za-z0-9_-]+)?(?![\\s\\S])"
        }
      ],
      "description": "Relative ASCII .html destination, optionally with a nonempty simple anchor. No protocol, query, encoded path, backslash or dot traversal. The release audit checks existence and anchors separately."
    },
    "date": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|Present|Unknown)(?![\\s\\S])"
    },
    "decisionDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?(?![\\s\\S])"
    },
    "texts": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "qualification": {
      "type": "object",
      "required": [
        "origin",
        "review",
        "verification",
        "evidence-availability"
      ],
      "properties": {
        "origin": {
          "enum": [
            "author-declared",
            "extracted-candidate",
            "inferred-proposal"
          ]
        },
        "review": {
          "enum": [
            "unreviewed",
            "author-reviewed",
            "independently-reviewed"
          ]
        },
        "verification": {
          "enum": [
            "unassessed",
            "self-reported",
            "externally-verified"
          ]
        },
        "evidence-availability": {
          "enum": [
            "public",
            "restricted",
            "unavailable",
            "awaiting-permission"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/text"
        },
        "reviewed-at": {
          "$ref": "#/$defs/decisionDate"
        },
        "verifier": {
          "$ref": "#/$defs/text"
        },
        "verified-at": {
          "$ref": "#/$defs/decisionDate"
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "source-verification": {
          "$ref": "#/$defs/text"
        },
        "source-status": {
          "$ref": "#/$defs/text"
        },
        "source-scope": {
          "$ref": "#/$defs/text"
        },
        "rights": {
          "$ref": "#/$defs/text"
        },
        "contribution": {
          "$ref": "#/$defs/text"
        },
        "causal-attribution": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "externally-verified"
              }
            }
          },
          "then": {
            "required": [
              "verifier",
              "verified-at",
              "method",
              "scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "review": {
                "const": "independently-reviewed"
              }
            }
          },
          "then": {
            "required": [
              "reviewer"
            ]
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": [
        "predicate",
        "target"
      ],
      "properties": {
        "predicate": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 80
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false,
      "description": "Exact public literal strings, not Markdown. A producer null or uncertain structure can be retained in a deliberately authored literal string such as null, not an omitted field or inferred value."
    },
    "public": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "qualification"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/destination"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "company": {
          "$ref": "#/$defs/text"
        },
        "organization": {
          "$ref": "#/$defs/text"
        },
        "grade": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "cv": {
          "$ref": "#/$defs/text"
        },
        "hours": {
          "$ref": "#/$defs/text"
        },
        "cpdHours": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "contact": {
          "$ref": "#/$defs/text"
        },
        "audience": {
          "$ref": "#/$defs/text"
        },
        "availability": {
          "$ref": "#/$defs/text"
        },
        "aliases": {
          "$ref": "#/$defs/texts"
        },
        "categories": {
          "$ref": "#/$defs/texts"
        },
        "assertions": {
          "$ref": "#/$defs/texts"
        },
        "relations": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "service": {
          "$ref": "#/$defs/service"
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "audience",
        "review",
        "rights"
      ],
      "properties": {
        "audience": {
          "const": "public"
        },
        "review": {
          "enum": [
            "author-reviewed",
            "independently-reviewed"
          ]
        },
        "rights": {
          "$ref": "#/$defs/text"
        },
        "consent": {
          "$ref": "#/$defs/text"
        },
        "reviewer": {
          "$ref": "#/$defs/text"
        },
        "reviewed-at": {
          "$ref": "#/$defs/decisionDate"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "review": {
            "const": "independently-reviewed"
          }
        }
      },
      "then": {
        "required": [
          "reviewer"
        ]
      }
    },
    "recordBase": {
      "type": "object",
      "required": [
        "id",
        "type",
        "publication"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "Person",
            "Role",
            "Project",
            "Skill",
            "Activity",
            "Output",
            "Outcome",
            "Impact",
            "PersonalReflection",
            "Evidence",
            "Time",
            "Assertion",
            "ServiceOffering",
            "EvidenceSource",
            "Relation"
          ]
        },
        "publication": {
          "type": "object",
          "required": [
            "audience"
          ],
          "properties": {
            "audience": {
              "enum": [
                "public",
                "private",
                "excluded"
              ]
            },
            "review": {},
            "rights": {},
            "consent": {},
            "reviewer": {},
            "reviewed-at": {}
          },
          "additionalProperties": false
        },
        "public": {},
        "private": {}
      },
      "additionalProperties": false
    },
    "selectedPublicRecord": {
      "required": [
        "public"
      ],
      "properties": {
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "public": {
          "$ref": "#/$defs/public"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Person"
              }
            }
          },
          "then": {
            "properties": {
              "publication": {
                "required": [
                  "consent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ServiceOffering"
              }
            }
          },
          "then": {
            "properties": {
              "public": {
                "required": [
                  "scope",
                  "contact",
                  "audience",
                  "availability"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Outcome",
                  "Impact"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "public": {
                "required": [
                  "assertions"
                ],
                "properties": {
                  "assertions": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Assertion"
              }
            }
          },
          "then": {
            "properties": {
              "public": {
                "required": [
                  "relations"
                ],
                "properties": {
                  "relations": {
                    "contains": {
                      "properties": {
                        "predicate": {
                          "enum": [
                            "supportedByEvidence",
                            "contradictedByEvidence",
                            "qualifiedByEvidence"
                          ]
                        }
                      },
                      "required": [
                        "predicate"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "service-typed-record-only",
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "ServiceOffering"
                }
              }
            }
          },
          "then": {
            "properties": {
              "public": {
                "not": {
                  "required": [
                    "service"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "recordWithServices": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "if": {
            "properties": {
              "publication": {
                "properties": {
                  "audience": {
                    "const": "public"
                  }
                }
              }
            }
          },
          "then": {
            "$ref": "#/$defs/selectedPublicRecord"
          }
        }
      ]
    },
    "recordWithoutServices": {
      "allOf": [
        {
          "$ref": "#/$defs/recordBase"
        },
        {
          "if": {
            "properties": {
              "publication": {
                "properties": {
                  "audience": {
                    "const": "public"
                  }
                }
              },
              "type": {
                "not": {
                  "const": "ServiceOffering"
                }
              }
            }
          },
          "then": {
            "$ref": "#/$defs/selectedPublicRecord"
          }
        }
      ]
    },
    "temporalEndpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "object",
          "properties": {
            "earliest": {
              "type": "string",
              "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?(?![\\s\\S])"
            },
            "latest": {
              "type": "string",
              "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?(?![\\s\\S])"
            }
          },
          "required": [
            "earliest",
            "latest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "temporal": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/temporalEndpoint"
        },
        "end": {
          "$ref": "#/$defs/temporalEndpoint"
        },
        "date": {
          "$ref": "#/$defs/temporalEndpoint"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "service": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "offered",
            "paused",
            "withdrawn"
          ]
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "validFrom": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "validThrough": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "jsonld": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "status",
        "provider"
      ],
      "additionalProperties": false
    },
    "languageBasis": {
      "type": "object",
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 128
            }
          ]
        },
        "revision": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 128
            }
          ]
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "revision",
        "modelDigest"
      ],
      "additionalProperties": false
    },
    "languagePage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "url": {
          "allOf": [
            {
              "$ref": "#/$defs/destination"
            },
            {
              "pattern": "^[^#]+\\.html(?![\\s\\S])"
            }
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*(?![\\s\\S])"
        },
        "revision": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 128
            }
          ]
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "semanticDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "review": {
          "const": "author-reviewed"
        },
        "reviewedBy": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 256
            }
          ]
        },
        "basedOn": {
          "$ref": "#/$defs/languageBasis"
        }
      },
      "required": [
        "id",
        "url",
        "language",
        "revision",
        "modelDigest",
        "semanticDigest",
        "review",
        "reviewedBy"
      ],
      "additionalProperties": false
    },
    "languagePages": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "primary": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 128
            }
          ]
        },
        "pages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/languagePage"
          }
        }
      },
      "required": [
        "version",
        "primary",
        "pages"
      ],
      "additionalProperties": false
    },
    "periodReport": {
      "type": "object",
      "properties": {
        "period": {
          "enum": [
            "day",
            "iso-week"
          ]
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        },
        "review": {
          "type": "object",
          "properties": {
            "reviewer": {
              "allOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "maxLength": 256
                }
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "reviewer",
            "date",
            "sourceDigest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "period",
        "start"
      ],
      "additionalProperties": false
    }
  }
}
